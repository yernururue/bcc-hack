# Скопируйте в .env и впишите ключ. Файл .env в git не попадает.

# Ключ OpenRouter: https://openrouter.ai/keys (или ключ OpenAI-совместимого шлюза)
LLM_API_KEY=

# OpenAI-совместимый эндпоинт. По умолчанию OpenRouter; для шлюза банка укажите его адрес.
LLM_BASE_URL=https://openrouter.ai/api/v1

# Модель по умолчанию. Для разработки и тестов — самая дешёвая; список и цены: config/models.yaml
LLM_MODEL=deepseek/deepseek-v4.1-flash

# Лимит стоимости одного прогона, $
LLM_MAX_COST_USD=0.50

# Кэш ответов LLM (off — выключить)
REQCHECK_CACHE_DIR=.cache/reqcheck

REQCHECK_LOG_LEVEL=INFO

# Если задан, HTTP API требует Authorization: Bearer <токен>
REQCHECK_API_TOKEN=
